{
  "name": "space-dog-racing",
  "private": true,
  "version": "0.0.1",
  "description": "Greyhound stable management on the grimy underground dog-racing circuit of a cartoon future.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @sdr/engine && npm run build -w @sdr/web",
    "test": "npm run typecheck -w @sdr/engine && npm test -w @sdr/engine",
    "harness": "npm run harness -w @sdr/engine --",
    "balance": "npm run balance -w @sdr/engine",
    "lint": "eslint packages",
    "format": "prettier --write \"packages/**/*.{ts,tsx,css,json}\" \"scripts/**/*.mjs\"",
    "snapshot": "node scripts/snapshot.mjs",
    "dev": "npm run dev -w @sdr/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "globals": "^17.12.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0"
  }
}
